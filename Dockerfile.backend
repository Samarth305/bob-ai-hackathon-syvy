FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY src/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy source — backend/, data/, llm/, frontend/ all land directly in /app
COPY src/ ./

# Expose port (Render overrides with $PORT env var at runtime)
EXPOSE 8000

# Hardcode PYTHONPATH inside CMD so no external env var can override it.
# /app is the WORKDIR and contains backend/, data/, llm/ as top-level packages.
CMD PYTHONPATH=/app uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}
