# =============================================================================
# ENVIRONMENT VARIABLES — Drug Safety Signal Detector & Submission Readiness Checker
# =============================================================================
# 1. Copy this file:   cp src/.env.example src/.env
# 2. Fill in values below
# 3. NEVER commit src/.env — it is in .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# IBM watsonx.ai  (REQUIRED for LLM rationale and gap reports)
# -----------------------------------------------------------------------------
# API key: IBM Cloud → Manage → Access (IAM) → API Keys → Create
WATSONX_API_KEY=your_api_key_here

# Project ID: watsonx.ai dashboard → your project → Manage → General → Project ID
WATSONX_PROJECT_ID=your_project_id_here

# Service endpoint — pick your region:
#   US South  → https://us-south.ml.cloud.ibm.com
#   EU Germany→ https://eu-de.ml.cloud.ibm.com
#   Tokyo     → https://jp-tok.ml.cloud.ibm.com
#   London    → https://eu-gb.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Granite model ID (leave as default unless you have access to a newer version)
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Port the FastAPI backend listens on
APP_PORT=8000

# -----------------------------------------------------------------------------
# openFDA FAERS API  (no key required for low-volume public queries)
# -----------------------------------------------------------------------------
# Base URL for the openFDA adverse event endpoint
OPENFDA_BASE_URL=https://api.fda.gov/drug/event.json

# Optional: your openFDA API key for higher rate limits (not required for demo)
# Register at: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
